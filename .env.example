# Copia este archivo como .env (cp .env.example .env) y llena los valores.

# Token del túnel de Cloudflare (Zero Trust > Networks > Tunnels > tu túnel > Install connector).
# Usa el token de un túnel NUEVO para este servicio, no el de Immich (ver README).
CLOUDFLARE_TUNNEL_TOKEN=

# Puerto en la Raspberry para acceder desde tu red local: http://<IP-raspberry>:8080
FRONT_PORT=8080

# Tamaño máximo de archivo en MB (si lo subes arriba de 29, sube también client_max_body_size en front/nginx.conf)
MAX_UPLOAD_MB=25

LOG_LEVEL=INFO
